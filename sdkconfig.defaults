#
# MI-RC003-ESP32-Bridge - default configuration (ESP32-S3, 16MB flash / 8MB PSRAM)
#

# ---- Target ---------------------------------------------------------------
CONFIG_IDF_TARGET="esp32s3"

# ---- Flash / PSRAM --------------------------------------------------------
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=n

# ---- Partition table ------------------------------------------------------
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ---- FreeRTOS -------------------------------------------------------------
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# ---- Bluetooth / NimBLE ---------------------------------------------------
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=512
CONFIG_BT_NIMBLE_L2CAP_COC_MAX_NUM=0
CONFIG_BT_NIMBLE_SM_LEGACY=y
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=5120
CONFIG_BT_NIMBLE_HS_FLOW_CTRL=y
CONFIG_BT_NIMBLE_HS_FLOW_CTRL_ITVL=1000
CONFIG_BT_NIMBLE_HS_FLOW_CTRL_THRESH=2

# ---- TinyUSB composite device --------------------------------------------
CONFIG_TINYUSB_HID_COUNT=1
# Left disabled on purpose: the composite device already provides WebUSB, and
# the log is served through it. A TinyUSB CDC interface would additionally need
# endpoint budget that the ESP32-S3 DWC2 does not have to spare alongside the
# isochronous microphone endpoint.
CONFIG_TINYUSB_CDC_ENABLED=n
CONFIG_TINYUSB_VENDOR_COUNT=1
CONFIG_TINYUSB_VENDOR_RX_BUFSIZE=4096
CONFIG_TINYUSB_VENDOR_TX_BUFSIZE=16384
CONFIG_TINYUSB_VENDOR_EPSIZE=64
CONFIG_TINYUSB_DESC_MANUFACTURER_STRING="MI-RC003"
CONFIG_TINYUSB_DESC_PRODUCT_STRING="MI-RC003 Remote Bridge"
CONFIG_TINYUSB_SUSPEND_CALLBACK=y
CONFIG_TINYUSB_RESUME_CALLBACK=y

# ---- Logging --------------------------------------------------------------
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# ---- Console --------------------------------------------------------------
# The board's UART port is the ESP-IDF primary console and is the one wired to
# a USB-UART bridge on this setup, so the log is read from there at 115200.
#
# The USB-Serial/JTAG secondary console is deliberately NOT enabled: with it on,
# the UART output was observed to arrive as 0x00/0x3f framing garbage, and the
# native USB port already carries the WebUSB log channel.
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
